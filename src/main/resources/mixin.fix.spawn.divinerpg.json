{
  "required": true,
  "package": "org.imesense.dynamicspawncontrol.mixins",
  "compatibilityLevel": "JAVA_8",
  "target": "@env(DEFAULT)",
  "minVersion": "0.8",
  "mixins":
  [
    "DivineRPG.MixinDivineRPGFixSpawn",
    "DivineRPG.MixinEntityPeacefulUntilAttacked",
    "DivineRPG.MixinEntityKobblin",
    "DivineRPG.MixinEntityPumpkinSpider"
  ],
  "injectors":
  {
    "maxShiftBy": 10
  }
}